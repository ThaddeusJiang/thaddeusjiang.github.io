#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT=$(cd "$(dirname "$0")" && pwd)
TIDDLYWIKI_VERSION=5.4.1
BUILD_TEMP_BASE=${TMPDIR:-/tmp}
BUILD_TEMP=$(mktemp -d "$BUILD_TEMP_BASE/tiddlywiki-build.XXXXXX")
WIKI_COPY="$BUILD_TEMP/wiki"
INDEX_OUTPUT="$BUILD_TEMP/index-output"
STAGED_DOCS="$BUILD_TEMP/docs"
PREVIOUS_DOCS="$BUILD_TEMP/previous-docs"

cleanup() {
  rm -rf -- "$BUILD_TEMP"
}

restore_previous_docs() {
  if [[ -d "$PREVIOUS_DOCS" && ! -e "$REPO_ROOT/docs" ]]; then
    mv "$PREVIOUS_DOCS" "$REPO_ROOT/docs"
  fi
}

trap cleanup EXIT
trap 'restore_previous_docs; exit 1' INT TERM

mkdir -p "$WIKI_COPY" "$INDEX_OUTPUT" "$STAGED_DOCS/assets" "$STAGED_DOCS/tiddlyjam"

rsync -a \
  --exclude='.git' \
  --exclude='docs' \
  --exclude='output' \
  "$REPO_ROOT/" "$WIKI_COPY/"

nub "$REPO_ROOT/scripts/export-images.ts" \
  "$REPO_ROOT/tiddlers" \
  "$STAGED_DOCS/assets"

npx --yes "tiddlywiki@$TIDDLYWIKI_VERSION" "$WIKI_COPY" \
  --setfield '[!is[system]is[image]]' _canonical_uri '$:/templates/canonical-uri-external-asset' text/plain \
  --setfield '[!is[system]is[image]]' text '' text/plain

npx --yes "tiddlywiki@$TIDDLYWIKI_VERSION" "$WIKI_COPY" \
  --output "$INDEX_OUTPUT" \
  --build index

cp "$INDEX_OUTPUT/index.html" "$STAGED_DOCS/index.html"

npx --yes "tiddlywiki@$TIDDLYWIKI_VERSION" "$WIKI_COPY" \
  --setfield '[!is[system]is[image]]' _canonical_uri '$:/templates/canonical-uri-tiddlyjam-asset' text/plain

npx --yes "tiddlywiki@$TIDDLYWIKI_VERSION" "$WIKI_COPY" \
  --output "$STAGED_DOCS/tiddlyjam" \
  --build tiddlyjam

if [[ -d "$REPO_ROOT/docs" ]]; then
  mv "$REPO_ROOT/docs" "$PREVIOUS_DOCS"
fi

if ! mv "$STAGED_DOCS" "$REPO_ROOT/docs"; then
  restore_previous_docs
  exit 1
fi
